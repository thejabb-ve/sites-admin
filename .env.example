# ─────────────────────────────────────────────────────────────
# Variables de entorno — admin/
#
# Copia este archivo como .env para desarrollo local.
# Para producción, configura estas variables en el Dashboard
# de Vercel (Settings → Environment Variables).
#
# Obtener valores locales: bun run db:status (en superplantilla/)
# ─────────────────────────────────────────────────────────────

# URL pública del proyecto Supabase
# Local:      http://127.0.0.1:54321
# Producción: https://<project-ref>.supabase.co
PUBLIC_SUPABASE_URL=

# Clave anon (pública, segura para el browser)
# Local:      bun run db:status → ANON_KEY
# Producción: Supabase Dashboard → Project Settings → API → anon public
PUBLIC_SUPABASE_ANON_KEY=

# Clave service_role (SECRETA — solo servidor, nunca al browser)
# Local:      bun run db:status → SERVICE_ROLE_KEY
# Producción: Supabase Dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=

# Secreto para firmar el JWT del CDN (cdn_token HttpOnly cookie)
# DEBE ser diferente en producción. Generar con: openssl rand -base64 32
# Este secreto también debe configurarse en el Worker CDN (Sprint 8).
JWT_SECRET=

# CDN Worker — uploads server-side con Sharp
# URL base del worker (sin trailing slash)
# Local/dev:   http://localhost:8787
# Producción:  https://cdn.<tu-dominio>.workers.dev
CDN_WORKER_URL=https://cdn.thejabb.com

# Secreto Bearer para autenticación server-to-server con el CDN worker
# Debe coincidir con CDN_UPLOAD_SECRET configurado en el worker
CDN_UPLOAD_SECRET=

# ─── Cloudflare — Caché, purga y registrar de dominios ───────────────────────
# Token de API de Cloudflare (Cloudflare Dashboard → My Profile → API Tokens)
# Permisos necesarios: Zone:Edit, Zone:Read, DNS:Edit, Cache Purge, Page Rules:Edit
CLOUDFLARE_API_TOKEN=

# Zone ID de la zona CF de la agencia (para purga de caché)
# Cloudflare Dashboard → selecciona la zona → Overview → Zone ID
CLOUDFLARE_ZONE_ID=

# Account ID de Cloudflare (panel derecho de cualquier zona → Account ID)
CLOUDFLARE_ACCOUNT_ID=

# ─── Vercel API — gestión de dominios custom ─────────────────────────────────
# Token de API de Vercel (Vercel Dashboard → Settings → Tokens)
VERCEL_API_TOKEN=

# ID del proyecto superplantilla en Vercel
# Vercel Dashboard → proyecto → Settings → General → Project ID
VERCEL_PROJECT_ID=

# ─── Resend — notificaciones de email ────────────────────────────────────────
# Resend Dashboard → API Keys → Create API Key
RESEND_API_KEY=

# Dirección remitente verificada en Resend
RESEND_FROM_EMAIL=noreply@tuagencia.com

# Email de la agencia que recibirá alertas técnicas
ALERT_EMAIL=
